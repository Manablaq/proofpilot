    "deploy:v7": "node scripts/deploy-proofpilot-v7.mjs"
  },
  "dependencies": {
    "framer-motion": "^12.23.6",
    "genlayer-js": "1.1.8",
    "next": "^15.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.54.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
