{
  "name": "proofpilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check:contract": "PYTHONPYCACHEPREFIX=/private/tmp/proofpilot-pycache python3 -m py_compile contracts/proofpilot.py",
